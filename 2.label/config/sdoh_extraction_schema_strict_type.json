{
  "Healthcare": {
    "name": "extract_healthcare_info",
    "description": "Extract structured healthcare information from a sentence. If there are multiple conditions or events, extract each as a separate item in the list.",
    "parameters": {
      "type": "object",
      "properties": {
        "extracted_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "enum": [
                  "Healthcare"
                ]
              },
              "Experiencer": {
                "type": "string",
                "enum": [
                  "grandparents",
                  "patients",
                  "Father",
                  "Family",
                  "Mother",
                  "siblings",
                  "relatives",
                  "parents/caregiver",
                  "patients and caregivers"
                ]
              },
              "healthcare_type": {
                "type": "string",
                "enum": [
                  "medications",
                  "surgeries/procedures",
                  "clinical visits",
                  "counseling",
                  "hospital stay"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "category",
              "Experiencer",
              "healthcare_type"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "extracted_conditions"
      ]
    },
    "strict": true
  },
